# LLM Provider: "ollama" | "openai" | "kimi"
LLM_PROVIDER=kimi

# Kimi For Coding (Anthropic-compat, UA-gated)
# Get key from Kimi CLI / Claude Code onboarding. Key prefix: sk-kimi-*
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding

# Startup health check — abort boot if selected provider is unreachable
LLM_STARTUP_HEALTHCHECK=true

# Ollama (local or AutoDL via SSH tunnel)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4-26b

# Generic OpenAI-compatible (fallback)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# M1 Backend — Postgres + data sources
DATABASE_URL=postgres://alpha:alpha@localhost:5432/alpha_test
FRED_API_KEY=
EDGAR_USER_AGENT=Alpha Agent v4 contact@example.com
LOG_LEVEL=INFO

# Shared bearer secret for Vercel Cron and GitHub Actions. Generate a long,
# random value and configure the same value in both production environments.
CRON_SECRET=

# Comma-separated administrator user IDs. Empty means no interactive admin.
ALPHACORE_ADMIN_USER_IDS=
# Small per-process pool for serverless deployment.
DB_POOL_MAX_SIZE=5
