{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["iad1"],
  "build": {
    "env": { "VERCEL_PYTHON_COMPILEALL": "0" }
  },
  "functions": { "api/index.py": { "maxDuration": 300 } },
  "crons": [
    { "path": "/api/cron/paper_bot/valuation", "schedule": "7,37 13-21 * * 1-5" },
    { "path": "/api/cron/paper_fill", "schedule": "0 1 * * *" },
    { "path": "/api/cron/paper_bot/wake", "schedule": "1,4 14,15 * * 1-5" },
    { "path": "/api/cron/paper_bot/wake", "schedule": "31,34 16,17,19,20 * * 1-5" }
  ]
}
